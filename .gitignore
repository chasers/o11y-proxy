# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
o11y_proxy-*.tar

# Temporary files, for example, from tests.
/tmp/

# Burrito single-file executables — tens of MB each (they bundle an ERTS).
# These are release artifacts, published to GitHub Releases, never committed.
/burrito_out/

# Local secrets for manual spikes/testing — never commit.
.env
.env.*
# ...except the checked-in sample (placeholders only, safe to publish).
!.env.sample

# Internal design/planning docs and local skills — not part of the public repo.
.plans/
.claude/

# Dialyzer PLTs — big, machine-specific, and cached in CI rather than committed.
/priv/plts/
