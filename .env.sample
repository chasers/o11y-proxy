# Copy to .env and fill in real values. .env is git-ignored — never commit real secrets.
#
# Used for the Phase 4 Sentry spike (live API checks) and, later, by
# O11yProxy.CredentialResolver via ${SENTRY_AUTH_TOKEN} in o11y.yaml.

# Org auth token — Settings > Auth Tokens, needs org:read (org:write/org:admin also work).
SENTRY_AUTH_TOKEN=

# Org slug, e.g. "acme" for sentry.io/organizations/acme/
SENTRY_ORG=

# Project slug to scope issue/event queries to.
SENTRY_PROJECT=
