{
  "openapi": "3.1.0",
  "info": {
    "title": "o11y-proxy",
    "version": "0.2.1",
    "description": "One HTTP+JSON interface over Sentry, ClickHouse, and VictoriaMetrics for logs, metrics, traces and errors. Also available as a CLI (`o11y-proxy --help`), which speaks to the same core and returns the same bodies."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4000"
    }
  ],
  "paths": {
    "/v1/sources": {
      "get": {
        "summary": "List configured sources, their signals, and capabilities",
        "operationId": "listSources",
        "responses": {
          "200": {
            "description": "Configured sources",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourcesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sources/{name}/schema": {
      "get": {
        "summary": "Canonical→native field map, filterable fields, cardinality hints, sampled example values for one source",
        "operationId": "getSourceSchema",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Source schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceSchema"
                }
              }
            }
          },
          "404": {
            "description": "No such source",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Per-source reachability",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Health status per configured source",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This spec",
        "operationId": "getOpenApiSpec",
        "responses": {
          "200": {
            "description": "The OpenAPI document"
          }
        }
      }
    },
    "/v1/query": {
      "post": {
        "summary": "Query logs, metrics, traces, or errors across one or more sources",
        "operationId": "query",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Always 200. Partial failure is a peer field, not a status code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Request failed validation (e.g. unsupported operator, raw query without allow_raw)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/context": {
      "post": {
        "summary": "Correlate one entity (trace, error, or service+window) across every source into one bundle",
        "operationId": "context",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContextRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Correlation bundle",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextResponse"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus exposition of this proxy's own metrics",
        "operationId": "metrics",
        "responses": {
          "200": {
            "description": "Prometheus text exposition format",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Signal": {
        "type": "string",
        "enum": [
          "logs",
          "metrics",
          "traces",
          "errors"
        ]
      },
      "Mode": {
        "type": "string",
        "enum": [
          "summary",
          "sample",
          "full"
        ],
        "description": "summary (default): time-bucketed aggregates only, no raw records. sample: summary plus N representative records spread across the window. full: raw records, cursor-paginated."
      },
      "Operator": {
        "type": "string",
        "enum": [
          "eq",
          "neq",
          "gte",
          "lte",
          "contains",
          "regex",
          "in",
          "exists"
        ]
      },
      "Severity": {
        "type": "string",
        "enum": [
          "trace",
          "debug",
          "info",
          "warn",
          "error",
          "fatal"
        ]
      },
      "Filter": {
        "type": "object",
        "required": [
          "field",
          "op",
          "value"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "Canonical field name, e.g. severity, service, body, attributes.<key>"
          },
          "op": {
            "$ref": "#/components/schemas/Operator"
          },
          "value": {}
        }
      },
      "CanonicalRecord": {
        "type": "object",
        "description": "Canonical shape for logs/traces/errors, loosely following OpenTelemetry semantic conventions. Unmapped native fields land in attributes.",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "RFC3339 UTC, always present"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "body": {
            "type": "string",
            "description": "log message or error title"
          },
          "service": {
            "type": "string"
          },
          "trace_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "the join key across every backend"
          },
          "span_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "attributes": {
            "type": "object",
            "description": "flat map, backend-native keys preserved"
          },
          "source": {
            "type": "string",
            "description": "which configured source produced this"
          }
        },
        "required": [
          "timestamp",
          "severity",
          "body",
          "service",
          "attributes",
          "source"
        ]
      },
      "MetricSeries": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "description": "unix_ms"
                },
                {
                  "type": "number"
                }
              ]
            }
          }
        },
        "required": [
          "name",
          "labels",
          "points"
        ]
      },
      "QueryRequest": {
        "type": "object",
        "required": [
          "sources",
          "signal",
          "from",
          "to"
        ],
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 1,
            "description": "Exactly one source name. Querying several at once is not supported: there is no merge/rank across sources yet. Use POST /v1/context to reach every configured source in one call, or issue one query per source."
          },
          "signal": {
            "$ref": "#/components/schemas/Signal"
          },
          "from": {
            "type": "string",
            "description": "RFC3339 or relative, e.g. now-15m"
          },
          "to": {
            "type": "string",
            "description": "RFC3339 or relative, e.g. now"
          },
          "filters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Filter"
            }
          },
          "raw": {
            "type": "string",
            "description": "Native query, per-source escape hatch. Replaces filters. Only permitted where the source config sets allow_raw: true."
          },
          "mode": {
            "$ref": "#/components/schemas/Mode",
            "default": "summary"
          },
          "limit": {
            "type": "integer",
            "default": 50
          },
          "order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "default": "desc"
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        }
      },
      "ContextRequest": {
        "type": "object",
        "description": "Exactly one of trace_id, error_id, or {from,to,service} identifies the entity to correlate.",
        "properties": {
          "trace_id": {
            "type": "string"
          },
          "error_id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "service": {
            "type": "string"
          }
        }
      },
      "ResponseError": {
        "type": "object",
        "required": [
          "source",
          "code",
          "message"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "rate_limited",
              "timeout",
              "unreachable",
              "invalid_query",
              "unsupported_operator",
              "internal"
            ]
          },
          "message": {
            "type": "string"
          },
          "retry_after_ms": {
            "type": "integer"
          }
        }
      },
      "ResponseMeta": {
        "type": "object",
        "properties": {
          "sources_queried": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "elapsed_ms": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          },
          "total_matched": {
            "type": "integer"
          },
          "returned": {
            "type": "integer"
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "native_queries": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "ResponseEnvelope": {
        "type": "object",
        "required": [
          "data",
          "meta",
          "errors"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/CanonicalRecord"
                },
                {
                  "$ref": "#/components/schemas/MetricSeries"
                },
                {
                  "type": "object",
                  "description": "summary bucket: {bucket, severity, service, count, ...group-by fields}"
                }
              ]
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResponseError"
            }
          }
        }
      },
      "ContextResponse": {
        "type": "object",
        "properties": {
          "trace": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CanonicalRecord"
            }
          },
          "logs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CanonicalRecord"
            }
          },
          "error": {
            "type": [
              "object",
              "null"
            ]
          },
          "metrics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricSeries"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResponseError"
            }
          }
        }
      },
      "SourceCapabilities": {
        "type": "object",
        "properties": {
          "signals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Signal"
            }
          },
          "operators": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Operator"
            }
          },
          "modes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Mode"
            }
          },
          "raw": {
            "type": "boolean"
          },
          "max_window": {
            "type": "string",
            "description": "e.g. 7d, or 'infinity'"
          }
        }
      },
      "Source": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "backend": {
            "type": "string",
            "enum": [
              "clickhouse",
              "victoriametrics",
              "sentry",
              "logflare"
            ]
          },
          "signal": {
            "$ref": "#/components/schemas/Signal"
          },
          "capabilities": {
            "$ref": "#/components/schemas/SourceCapabilities"
          }
        }
      },
      "SourcesResponse": {
        "type": "object",
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          }
        }
      },
      "SourceSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "canonical": {
                  "type": "string"
                },
                "native": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "filterable": {
                  "type": "boolean"
                },
                "cardinality": {
                  "type": "string",
                  "enum": [
                    "low",
                    "high",
                    "unknown"
                  ]
                },
                "sample_values": {
                  "type": "array",
                  "items": {}
                }
              }
            }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "sources": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "ok",
                    "error"
                  ]
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
